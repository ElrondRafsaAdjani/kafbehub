/*
  ATURAN AKSES FIRESTORE (Firestore Security Rules)

  INI SATU-SATUNYA PENGAMAN DATA KAFBE HUB.

  Halaman /operasional hanyalah antarmuka. Siapa pun bisa membuka Console
  peramban dan memanggil Firestore langsung tanpa melewati halaman itu sama
  sekali. Yang menolak mereka adalah berkas ini, bukan halaman loginnya.

  CARA MEMASANG:
  1. Buka https://console.firebase.google.com -> pilih proyek "kafbe-hub"
  2. Build -> Firestore Database -> tab "Rules"
  3. Hapus seluruh isinya, tempel seluruh isi berkas ini, klik "Publish"

  Berkas ini disimpan di repo hanya sebagai salinan acuan supaya tidak hilang
  dan bisa ditinjau. Firestore TIDAK membacanya dari sini, jadi setiap kali
  berkas ini diubah, isinya harus ditempel ulang lewat langkah di atas.

  CARA MENAMBAH PENGURUS OPERASIONAL BARU (misalnya adik tingkat yang meneruskan):
  Calon pengurus mendaftar sendiri lewat tautan "Daftar akun baru" di halaman
  masuk /operasional, dengan nama, NRP, email, dan kata sandi. Pengurus yang
  sudah ada lalu menerima atau menolaknya di tab "Akun Operasional". Sampai
  diterima, akun itu bisa masuk tetapi tidak bisa membuka apa pun.

  Menambah lewat Firebase Console tetap bisa, untuk keadaan darurat saat belum
  ada satu pun pengurus yang bisa menyetujui:
  1. Authentication -> Users -> Add user -> isi email dan password
  2. Salin nilai "User UID" yang muncul di daftar
  3. Firestore Database -> Data -> koleksi "admins" -> Add document
     - Document ID : tempel User UID tadi
     - Field       : nama (string), isi nama orangnya
  Tanpa langkah nomor 3, akun itu bisa login tapi tidak bisa mengubah apa pun.

  TIGA TINGKAT WEWENANG, DAN KENAPA DIPISAH:

    admins       -> halaman /operasional. Mengelola jadwal, perubahan
                    sementara, pengajar, dan pengumuman.
    pengajarakun -> halaman /pengajar. Mengubah naskah materi kuliah, dan
                    hanya pada mata kuliah yang disebut di dokumennya.
    adminutama   -> halaman /adminkafbe. Mengubah naskah situs, mematikan
                    fitur, dan menutup seluruh situs untuk pemeliharaan.

  Ketiganya koleksi terpisah dan tidak saling mewarisi. Terdaftar di "admins"
  tidak memberi akses ke /adminkafbe maupun /pengajar. Untuk memberi wewenang
  lain, ulangi langkah 1 sampai 3 di atas tapi pakai koleksi yang sesuai.

  Pemisahan ini disengaja: pengurus operasional berganti tiap kepengurusan dan
  jumlahnya banyak, pengajar hanya menyentuh naskah mata kuliahnya sendiri, dan
  yang boleh menutup situs sebaiknya sedikit.

  CARA MENAMBAH AKUN PENGAJAR:
  Tidak lewat Firebase Console. Pengajar mendaftar sendiri di halaman
  /pengajar dengan NRP, nama lengkap, dan email student UBAYA, lalu pengurus
  operasional menerima atau menolaknya di tab "Akun Pengajar". Aturan di bawah
  memastikan pendaftar tidak bisa menyetujui dirinya sendiri.

  Menambah lewat Console tetap boleh untuk keadaan darurat, misalnya saat
  belum ada satu pun pengurus yang bisa menyetujui. Dokumennya diisi:
    - nama   (string) : nama pengajarnya
    - nrp    (string) : NRP-nya
    - email  (string) : email akun Firebase-nya
    - status (string) : isi "diterima"
    - mk     (array)  : kode mata kuliah yang boleh diubah, misalnya
                        ["pemi", "stat2"]. Kodenya lihat shared/materi-daftar.js
    - semua  (boolean, opsional) : isi true kalau boleh mengubah semua mata
                        kuliah. Kalau diisi true, kolom mk tidak dipakai.

  CARA MENCABUT AKSES PENGURUS OPERASIONAL:
  Admin operasional bisa dicabut dari web: tab "Akun Operasional", daftar
  "Pengurus aktif", tombol "Cabut". Pencabutannya diminta dikonfirmasi dua
  kali. Yang tidak bisa dicabut dari web adalah admin absolut, lihat di bawah.
  Lewat Firebase Console juga tetap bisa: hapus dokumennya dari koleksi
  "admins", efeknya langsung.

  ADMIN ABSOLUT:
  Satu atau beberapa pengurus yang tidak bisa dicabut oleh siapa pun lewat web.
  Ditandai dengan kolom "absolut" bernilai true pada dokumennya di koleksi
  "admins", dan kolom itu HANYA bisa diisi lewat Firebase Console. Aturan di
  bawah menolak dokumen admins yang membawa kolom itu saat dibuat dari web, dan
  menolak semua pengubahan dari web, jadi tidak ada jalan mengangkat diri
  sendiri menjadi absolut maupun mencopot keabsolutan orang lain.

  Cara menandainya: Firestore Database -> Data -> koleksi "admins" -> buka
  dokumen pengurusnya -> Add field: absolut (boolean) = true.
*/

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benar hanya jika: sudah login DAN terdaftar di koleksi "admins".
    // Sekadar punya akun tidak cukup, sehingga akun yang bocor pun tidak
    // otomatis bisa mengubah data selama tidak didaftarkan di sini.
    function adminTerdaftar() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function tulisanAdmin() {
      return adminTerdaftar();
    }

    /*
      Tingkat kedua, di atas admin operasional.

      Pengurus operasional mengelola jadwal dan pengumuman. Yang mengubah
      tampilan situs, mematikan fitur, dan menutup seluruh situs adalah orang
      lain lagi, dan wewenang itu ditentukan koleksi "adminutama".

      Terdaftar di "admins" TIDAK memberi wewenang ini. Kedua koleksi berdiri
      sendiri, jadi pengurus operasional yang membuka /adminkafbe akan ditolak
      di sini, bukan cuma disembunyikan tombolnya di halaman.
    */
    function adminUtama() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminutama/$(request.auth.uid));
    }

    /*
      Tingkat tersendiri di samping keduanya: pengajar mata kuliah.

      Bedanya dengan dua tingkat di atas, wewenang pengajar TIDAK berlaku untuk
      seluruh koleksi, melainkan dibatasi per mata kuliah. Dokumen akunnya
      menyebut kode mata kuliah mana saja yang boleh disentuh, dan pembatasan
      itu ditegakkan di sini, bukan sekadar dengan menyaring daftar topik di
      halaman /pengajar. Daftar di halaman itu bisa dilewati lewat Console
      peramban; aturan ini tidak bisa.

      Kolom "semua" bernilai true dipakai untuk koordinator yang memang
      mengurus seluruh mata kuliah, supaya daftar mk-nya tidak perlu ditambah
      tiap kali ada mata kuliah baru.
    */
    function pengajarTerdaftar() {
      return request.auth != null
        && exists(/databases/$(database)/documents/pengajarakun/$(request.auth.uid));
    }

    function akunPengajar() {
      return get(/databases/$(database)/documents/pengajarakun/$(request.auth.uid)).data;
    }

    /*
      Punya dokumen saja tidak cukup, sebab dokumennya kini dibuat sendiri oleh
      yang mendaftar dan statusnya masih menunggu.

      Dokumen yang tidak menyebut status dianggap sudah diterima. Itu hanya
      berlaku untuk dokumen yang dibuat langsung lewat Firebase Console, karena
      pendaftaran dari web selalu dipaksa berstatus menunggu oleh aturan di
      bawah. Jadi bawaan ini tidak bisa dipakai melewati persetujuan.
    */
    function pengajarAktif() {
      return pengajarTerdaftar()
        && akunPengajar().get('status', 'diterima') == 'diterima';
    }

    function pengajarBoleh(kode) {
      return pengajarAktif()
        && (akunPengajar().get('semua', false) == true
            || kode in akunPengajar().get('mk', []));
    }

    // ---------- Daftar pengurus operasional ----------
    /*
      Dulu koleksi ini tidak bisa ditulis dari web sama sekali, dan alasannya
      bagus: pengurus yang akunnya diambil alih tidak bisa mengangkat pengurus
      baru diam-diam. Aturan itu dilonggarkan SATU langkah, dengan sadar, karena
      pengurus berganti tiap kepengurusan dan mengharuskan buka Firebase Console
      untuk tiap orang berakhir dengan satu akun yang dipakai beramai-ramai.
      Akun bersama justru menghapus jejak siapa mengubah apa.

      Yang dibuka hanya MENERIMA pendaftar yang sudah mengajukan diri:

        1. Dokumen hanya bisa dibuat oleh pengurus yang sudah terdaftar, dan
           bukan untuk dirinya sendiri.
        2. Harus ada pengajuan di "adminakun" dengan UID yang sama, dan nama
           serta email yang ditulis harus persis sama dengan pengajuan itu.
           Jadi pengurus tidak bisa mengangkat akun sembarang yang tidak pernah
           mendaftar, dan tidak bisa mengubah identitas pendaftar saat
           menerimanya.
        3. Kolom diputusOleh harus email akun yang sedang login, sehingga
           setiap pengangkatan tercatat siapa yang menyetujuinya.

      MENCABUT dibuka dengan dua pagar. Pengurus tidak bisa mencabut dirinya
      sendiri, dan tidak bisa mencabut dokumen yang kolom "absolut"-nya true.
      Kolom itu hanya bisa diisi lewat Firebase Console, karena create dari web
      menolaknya dan update dari web ditutup sama sekali. Jadi admin absolut
      adalah pembatas terakhir: akun admin operasional yang diambil alih bisa
      menyingkirkan admin operasional lain, tetapi tidak pernah bisa menyingkirkan
      admin absolut, dan admin absolut selalu bisa membereskannya.

      Mengubah tetap ditutup. Nama dan email pengurus dikunci pada nilai saat
      diangkat, dan keabsolutan tidak bisa dinyalakan atau dimatikan dari web.
    */
    function pengangkatanSah(uid, isi) {
      let ajuan = get(/databases/$(database)/documents/adminakun/$(uid)).data;
      return isi.keys().hasOnly(['nama', 'email', 'diputusOleh', 'diputusPada'])
        && isi.nama == ajuan.nama
        && isi.email == ajuan.email
        && isi.diputusOleh == request.auth.token.email;
    }

    match /admins/{uid} {
      // Tiap akun membaca dokumennya sendiri saat masuk. Pengurus yang sudah
      // terdaftar boleh membaca seluruhnya untuk melihat siapa saja yang aktif.
      allow read: if request.auth != null
                  && (request.auth.uid == uid || adminTerdaftar());
      allow create: if adminTerdaftar()
                    && request.auth.uid != uid
                    && exists(/databases/$(database)/documents/adminakun/$(uid))
                    && pengangkatanSah(uid, request.resource.data);
      allow update: if false;
      allow delete: if adminTerdaftar()
                    && request.auth.uid != uid
                    && resource.data.get('absolut', false) != true;
    }

    // ---------- Pengajuan akun pengurus operasional ----------
    /*
      Antrean pendaftar untuk halaman /operasional. Polanya sama dengan
      "pengajarakun" di bawah: pendaftar hanya boleh membuat dokumen atas
      namanya sendiri dengan status menunggu, dan yang memutuskan adalah
      pengurus yang sudah ada. Identitas pendaftar dikunci pada nilai yang
      diajukan, jadi keputusan tidak bisa sekaligus menyunting siapa dia.

      Bedanya dari pengajar, tidak ada kolom wewenang sama sekali. Wewenangnya
      satu dan bulat: masuk ke koleksi "admins" atau tidak.
    */
    function pengajuanAdminSah(isi) {
      return isi.keys().hasOnly(['status', 'nrp', 'nama', 'email', 'dibuatPada'])
        && isi.status == 'menunggu'
        && isi.nrp is string
        && isi.nrp.matches('^[0-9]{6,15}$')
        && isi.nama is string
        && isi.nama.size() >= 3
        && isi.nama.size() <= 80
        && isi.email == request.auth.token.email;
    }

    function keputusanAdminSah(lama, baru) {
      return baru.keys().hasOnly([
               'status', 'nrp', 'nama', 'email', 'dibuatPada',
               'diputusPada', 'diputusOleh', 'alasan'
             ])
        && baru.nrp   == lama.nrp
        && baru.nama  == lama.nama
        && baru.email == lama.email
        && baru.status in ['menunggu', 'diterima', 'ditolak', 'dicabut']
        && baru.diputusOleh == request.auth.token.email
        && baru.get('alasan', '') is string
        && baru.get('alasan', '').size() <= 200;
    }

    match /adminakun/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || adminTerdaftar());

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && pengajuanAdminSah(request.resource.data);

      allow update: if adminTerdaftar()
                    && keputusanAdminSah(resource.data, request.resource.data);

      /*
        Menghapus hanya untuk baris yang belum diangkat. Selama dokumen di
        "admins" masih ada, baris pengajuannya ikut dikunci, supaya daftar
        pengurus aktif dan riwayat pengajuannya tidak bisa saling bertentangan.
        Menghapus baris yang ditolak adalah cara memberi kesempatan mendaftar
        ulang, karena aturan create menolak dokumen yang sudah ada.
      */
      allow delete: if adminTerdaftar()
                    && !exists(/databases/$(database)/documents/admins/$(uid));
    }

    // ---------- Daftar admin utama ----------
    // Aturannya sama dengan "admins": hanya bisa ditambah lewat Firebase
    // Console, tidak pernah dari web, bahkan oleh admin utama sendiri.
    match /adminutama/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Daftar akun pengajar ----------
    /*
      BEDA SENDIRI DARI DUA DAFTAR DI ATAS: koleksi ini boleh ditulis dari web.

      Admin dan admin utama hanya bisa ditambah lewat Firebase Console, sebab
      jumlahnya sedikit dan wewenangnya luas. Pengajar jumlahnya banyak dan
      berganti tiap semester, jadi mengharuskan pengurus membuka Firebase
      Console untuk tiap orang hanya akan berakhir dengan satu akun yang
      dipakai beramai-ramai. Karena itu pendaftarannya dibuka, tapi
      persetujuannya tetap di tangan pengurus operasional.

      PEMBAGIAN YANG DIJAGA DI SINI

      Pendaftar hanya boleh MEMBUAT dokumen atas namanya sendiri, dengan
      status menunggu, dan tanpa satu pun kolom wewenang. Kolom "mk" dan
      "semua" tidak boleh ikut ditulis sama sekali pada tahap ini.

      Pengurus operasional yang MENGUBAH statusnya dan mengisi wewenangnya.
      Sebaliknya, pengurus tidak boleh menyunting nama, NRP, maupun email
      pendaftar, sehingga baris yang disetujui tetap baris yang diajukan.

      Kalau pemisahan ini dilonggarkan, seorang pendaftar bisa membuat
      dokumennya sendiri lengkap dengan status diterima dan daftar mata kuliah
      apa pun. Batas wewenang yang bisa ditulis sendiri oleh yang dibatasi
      tidak membatasi apa pun.
    */
    function pengajuanSah(isi) {
      return isi.keys().hasOnly(['status', 'nrp', 'nama', 'email', 'dibuatPada'])
        && isi.status == 'menunggu'
        && isi.nrp is string
        && isi.nrp.matches('^[0-9]{6,15}$')
        && isi.nama is string
        && isi.nama.size() >= 3
        && isi.nama.size() <= 80
        && isi.email == request.auth.token.email
        && isi.email.matches('^s[0-9]{6,15}@student[.]ubaya[.]ac[.]id$');
    }

    /*
      Keputusan pengurus. Yang boleh berubah hanya status, wewenang, dan
      catatan keputusannya. Identitas pendaftar dikunci pada nilai yang sudah
      tersimpan.
    */
    function keputusanSah(lama, baru) {
      return baru.keys().hasOnly([
               'status', 'nrp', 'nama', 'email', 'dibuatPada',
               'mk', 'semua', 'diputusPada', 'diputusOleh', 'alasan'
             ])
        && baru.nrp   == lama.nrp
        && baru.nama  == lama.nama
        && baru.email == lama.email
        && baru.status in ['menunggu', 'diterima', 'ditolak']
        && baru.diputusOleh == request.auth.token.email
        && baru.get('mk', []) is list
        && baru.get('mk', []).size() <= 30
        && baru.get('semua', false) is bool
        && baru.get('alasan', '') is string
        && baru.get('alasan', '').size() <= 200;
    }

    match /pengajarakun/{uid} {
      /*
        Pendaftar membaca dokumennya sendiri untuk tahu status pengajuannya,
        dan pengurus operasional membaca seluruhnya untuk menilai antrean.
        Selain keduanya, tertutup: isinya nama, NRP, dan email orang.
      */
      allow read: if request.auth != null
                  && (request.auth.uid == uid || adminTerdaftar());

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && pengajuanSah(request.resource.data);

      allow update: if adminTerdaftar()
                    && keputusanSah(resource.data, request.resource.data);

      /*
        Menghapus hanya oleh pengurus, dan gunanya bukan membersihkan jejak.
        Selama dokumennya masih ada, orang yang sama tidak bisa mendaftar lagi
        karena aturan create menolak dokumen yang sudah ada. Menghapus baris
        yang ditolak itulah cara memberi kesempatan mendaftar ulang.
      */
      allow delete: if adminTerdaftar();
    }

    // ---------- Dokumen ringkasan untuk halaman publik ----------
    // Dibaca semua pengunjung, ditulis ulang oleh halaman admin tiap menyimpan.
    //
    // Dokumen "situs" sengaja DIKECUALIKAN di sini dan diatur sendiri di bawah.
    // Firestore mengizinkan akses bila ADA SATU saja aturan yang mengizinkan,
    // bukan yang paling khusus, jadi tanpa pengecualian ini pengurus
    // operasional tetap bisa menulis publik/situs lewat aturan umum ini.
    match /publik/{doc} {
      allow read: if true;
      allow write: if tulisanAdmin() && doc != 'situs';
    }

    // ---------- Pengaturan tampilan situs ----------
    /*
      Ditulis hanya dari /adminkafbe, dibaca setiap halaman publik.

      Syarat "situs harus berstatus maintenance sebelum boleh diubah"
      ditegakkan DI SINI, bukan sekadar dengan menonaktifkan kotak isian di
      halaman admin. Halaman admin bisa dilewati lewat Console peramban;
      aturan ini tidak bisa.

      Ada dua jalan yang diizinkan:
        1. Dokumennya sudah berstatus maintenance, sehingga isinya bebas
           diubah selagi pengunjung melihat layar pemeliharaan.
        2. Yang berubah hanya saklar statusnya sendiri, sehingga situs tetap
           bisa dimasukkan ke dan dikeluarkan dari pemeliharaan.

      Akibatnya, mengubah naskah atau status fitur saat situs masih aktif
      selalu ditolak server, siapa pun yang mencoba dan lewat cara apa pun.
    */
    match /publik/situs {
      allow read: if true;
      allow create: if adminUtama();
      allow update: if adminUtama() && (
           resource.data.statusSitus == 'maintenance'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statusSitus', 'diperbaruiPada', 'diperbaruiOleh'])
      );
      allow delete: if false;
    }

    // ---------- Catatan kunjungan ----------
    /*
      Satu dokumen per hari, ditambah oleh pengunjung anonim lewat
      shared/kunjungan.js, dan hanya dibaca admin utama di dasbor.

      APA YANG BISA DAN TIDAK BISA DIJAMIN DI SINI

      Bentuk datanya dibatasi: nama dokumen harus berupa tanggal, dan hanya
      tujuh kolom di bawah yang boleh ditulis. Jadi koleksi ini tidak bisa
      dipakai orang lain sebagai tempat menitipkan data sembarangan.

      Yang TIDAK bisa dicegah tanpa server sendiri adalah orang menaikkan
      angkanya dengan memanggil Firestore berulang kali. Angka di dasbor
      karena itu perlu dibaca sebagai gambaran ramai sepinya kunjungan, bukan
      sebagai hitungan yang bisa dipertanggungjawabkan.

      Menghapus ditutup rapat, sehingga catatan yang sudah masuk tidak bisa
      dihilangkan lewat web oleh siapa pun.
    */
    match /statistik/{hari} {
      allow read: if adminUtama();
      allow create, update: if hari.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly([
             'tanggal', 'tampilan', 'perangkat', 'jam',
             'halaman', 'durasiTotal', 'durasiJumlah'
           ]);
      allow delete: if false;
    }

    // ---------- Catatan versi ----------
    // Catatan perubahan yang ditulis admin utama. Tidak dibuka untuk publik
    // karena isinya catatan kerja internal, termasuk siapa yang menulisnya.
    //
    // Sengaja TIDAK ikut disyaratkan status maintenance: catatan ini merekam
    // pekerjaan yang sudah selesai, dan biasanya baru ditulis setelah situs
    // dinyalakan kembali. Menguncinya akan membuat catatan justru tidak ditulis.
    match /catatanversi/{id} {
      allow read: if adminUtama();
      allow write: if adminUtama();
    }

    // ---------- Data kerja admin ----------
    // Boleh dibaca publik supaya halaman jadwal tetap bisa jalan seandainya
    // dokumen ringkasan bermasalah, tapi hanya admin yang boleh mengubah.
    match /matakuliah/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /jadwal/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /perubahan/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // Template story Instagram yang diunggah di tab "PR" (satu dokumen per jenis
    // pengumuman, misalnya story dan story-permanen), beserta pengaturannya.
    // Gambarnya disimpan sebagai potongan teks base64 (lihat
    // shared/operasional.js). Hanya pengurus yang memakainya, jadi tidak
    // dibuka untuk publik.
    match /templateig/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // Grup mata kuliah buatan pengurus (misalnya mahasiswa baru dan lama),
    // untuk menyaring kelas pada pembuatan massal. Hanya dipakai di halaman
    // operasional, jadi tidak dibuka untuk publik.
    match /grupmatkul/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    match /pengumuman/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Naskah materi kuliah ----------
    /*
      Satu dokumen per topik, dengan Document ID sama dengan nama berkas
      halamannya, misalnya "pemi-elastisitas". Isinya naskah pengganti yang
      ditulis pengajar lewat halaman /pengajar, dan dibaca setiap mahasiswa
      yang membuka halaman materinya.

      TIGA HAL YANG DIJAGA DI SINI

      1. Hanya pengajar yang berwenang atas mata kuliahnya yang boleh menulis.
      2. Nama dokumennya harus diawali kode mata kuliah yang sama dengan isi
         kolom "kode". Tanpa syarat ini, pengajar Pengantar Mikroekonomi bisa
         menulis dokumen "stat2-nilai-z" sambil mengisi kodenya "pemi", dan
         pemeriksaan wewenang di atas akan meloloskannya.
      3. Bentuk datanya dibatasi, sehingga koleksi ini tidak bisa dipakai
         sebagai tempat menitipkan data lain.

      Menghapus ditutup untuk semua orang. Mengembalikan naskah ke bawaan
      halaman dilakukan dengan mengosongkan isinya lewat halaman /pengajar,
      bukan dengan menghapus dokumennya, sehingga catatan siapa yang terakhir
      mengubah tidak ikut hilang.

      Yang TIDAK dijaga di sini adalah isi markup-nya. Naskah tetap disaring
      shared/materi.js di sisi pembaca sebelum dipasang ke halaman.
    */
    function materiSah(id, isi) {
      return isi.keys().hasOnly([
               'kode', 'naskah', 'langkah', 'peta',
               'diperbaruiPada', 'diperbaruiOleh'
             ])
        && isi.kode is string
        && id.split('-')[0] == isi.kode
        && isi.naskah is map
        && isi.langkah is map
        && isi.peta is map
        && isi.diperbaruiOleh == request.auth.token.email;
    }

    match /materi/{id} {
      allow read: if true;
      allow create: if materiSah(id, request.resource.data)
                    && pengajarBoleh(request.resource.data.kode);
      allow update: if materiSah(id, request.resource.data)
                    && pengajarBoleh(request.resource.data.kode)
                    && pengajarBoleh(resource.data.kode);
      allow delete: if false;
    }

    // ---------- Data pengajar ----------
    // Nama dan NRP asisten memang sudah diumumkan lewat kanal resmi KAFBE,
    // jadi tidak ada yang perlu dirahasiakan dan aturannya disamakan dengan
    // koleksi lain.
    //
    // Meski begitu, datanya tetap TIDAK ditampilkan di halaman mana pun yang
    // dibuka mahasiswa, dan tidak ikut ditulis ke dokumen publik/terkini.
    // Hanya halaman operasional yang memakainya.
    match /pengajar/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Kode kelas Google Classroom ----------
    /*
      BEDA SENDIRI DARI KOLEKSI LAIN: koleksi ini TIDAK boleh dibaca publik.

      Kode kelas adalah kunci masuk. Siapa pun yang memegangnya bisa bergabung
      ke kelas daring mata kuliah mana pun tanpa pernah menjadi mahasiswanya,
      lalu ikut melihat materi dan tugas di dalamnya. Karena itu aturannya
      dibuat tertutup, tidak disamakan dengan jadwal yang memang diumumkan.
    */
    match /classroom/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Koordinator mata kuliah ----------
    /*
      Ikut ditutup dari publik dengan alasan berbeda: isinya nomor WA dan akun
      Line pengurus. Nama dan NRP memang sudah diumumkan, tapi kontak pribadi
      tidak, dan sekali koleksi ini dibuka, seluruh daftar kontak pengurus bisa
      diunduh sekaligus oleh siapa saja.
    */
    match /koordinator/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Catatan aksi pengurus ----------
    /*
      HANYA BISA DITAMBAH. Mengubah dan menghapus ditutup untuk semua orang,
      termasuk pengurus yang menulisnya sendiri.

      Ini inti gunanya. Catatan yang bisa dirapikan sendiri oleh pelakunya
      tidak bisa dipakai menelusuri apa pun, karena bagian yang paling ingin
      ditelusuri justru yang paling mungkin dihapus. Membersihkan catatan lama
      hanya bisa lewat Firebase Console, dan itu memang disengaja.

      Pengajar ikut boleh menambah catatan, karena perubahan naskah materi juga
      perlu bisa ditelusuri. Membacanya tetap hanya pengurus operasional,
      sebab catatan ini memuat pekerjaan semua orang, bukan hanya pekerjaan
      yang menulisnya.

      Tidak dibuka untuk publik karena isinya menyebut nama dan email pengurus,
      beserta jam kerja mereka.

      Bentuk datanya dibatasi supaya koleksi ini tidak bisa dipakai sebagai
      tempat menitipkan data lain, dan supaya baris palsu tidak bisa ditulis
      atas nama orang lain: kolom email harus sama dengan email akun yang
      sedang login.
    */
    match /log/{id} {
      allow read: if adminTerdaftar();
      allow create: if (tulisanAdmin() || pengajarAktif())
        && request.resource.data.keys().hasOnly([
             'waktu', 'waktuKlien', 'oleh', 'email', 'aksi', 'jenis', 'ringkas', 'rincian'
           ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.aksi is string
        && request.resource.data.jenis is string
        && request.resource.data.ringkas.size() <= 500
        && request.resource.data.rincian.size() <= 500;
      allow update, delete: if false;
    }

    // ---------- Papan skor game ----------
    // Dibiarkan seperti sebelumnya: siapa pun boleh menambah skor tanpa login,
    // tapi bentuk datanya dibatasi, dan skor yang sudah masuk tidak bisa
    // diubah atau dihapus oleh siapa pun lewat web.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.game is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 14
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100000;
      allow update, delete: if false;
    }

    // ---------- Game Agenda Tersembunyi ----------
    /*
      Enam ruang tetap: tiga ruang publik dan tiga ruang terkunci. Pemain
      tidak membuat akun. Halaman game masuk diam-diam memakai Anonymous Auth
      (harus dinyalakan sekali di Firebase Console: Authentication, Sign-in
      method, Anonymous), sehingga setiap pemain tetap punya UID yang bisa
      dipakai aturan di bawah.

      Akun anonim tidak membuka pintu lain di berkas ini. Semua aturan di atas
      memeriksa email, koleksi admins, atau koleksi pengajarakun, dan akun
      anonim tidak memiliki satu pun di antaranya.

      SIAPA BOLEH MENULIS APA

        Ruang (agendaruang/{id})
          - Siapa pun yang masuk boleh MEMBUKA ruang publik yang kosong atau
            yang sudah kedaluwarsa, dan otomatis menjadi host.
          - Hanya host yang boleh menjalankan permainan dan memindahkan host
            ke pemain lain di sesi yang sama.
          - Pemain boleh MENGAMBIL ALIH host jika host lama berhenti mengirim
            detak selama 45 detik, atau jika ruang belum punya host.
          - Ruang terkunci hanya bisa dibuka dan ditutup asisten, yaitu akun
            pengajar yang sudah diterima atau pengurus operasional.

        Kedaluwarsa
          - Ruang publik yang belum mulai dalam 10 menit sejak dibuka.
          - Ruang yang host-nya berhenti mengirim detak selama 3 menit.
          - Permainan yang sudah selesai lebih dari 5 menit.
          Ruang kedaluwarsa boleh dikosongkan siapa pun. Tidak ada proses di
          server yang membubarkannya; halaman game sendiri yang menganggapnya
          bubar, dan pemain berikutnya yang mengosongkannya.

        Kode akses ruang terkunci (agendakunci/{id})
          - Hanya asisten yang boleh membaca dan menulisnya. Pemain tidak
            pernah membaca kode ini. Saat bergabung, pemain mengirim kode yang
            diketikkannya dan aturan di bawah mencocokkannya di server.

      YANG TIDAK DIJAGA DI SINI

      Isi permainan (kubu, voting, intel) bisa dibaca semua anggota ruang
      lewat Console peramban. Rahasia antar kubu dijaga oleh tampilan, bukan
      oleh server, karena tanpa server sendiri tetap harus ada satu peramban
      (host) yang membaca seluruh suara untuk menghitung hasilnya. Untuk ice
      breaking di kelas, hal itu sudah memadai.
    */
    function ruangAgendaSah(id) {
      return id in ['publik-1', 'publik-2', 'publik-3', 'kunci-1', 'kunci-2', 'kunci-3'];
    }

    function jenisRuangAgenda(id) {
      return id.matches('publik-[0-9]') ? 'publik' : 'terkunci';
    }

    function asistenAgenda() {
      return pengajarAktif() || adminTerdaftar();
    }

    function dataRuang(id) {
      return get(/databases/$(database)/documents/agendaruang/$(id)).data;
    }

    function anggotaSesi(id, uid, sesi) {
      return exists(/databases/$(database)/documents/agendaruang/$(id)/pemain/$(uid))
        && get(/databases/$(database)/documents/agendaruang/$(id)/pemain/$(uid)).data.sesi == sesi;
    }

    function anggotaAgenda(id) {
      return request.auth != null
        && anggotaSesi(id, request.auth.uid, dataRuang(id).sesi);
    }

    function detakBasi(id, detik) {
      return !exists(/databases/$(database)/documents/agendaruang/$(id)/detak/host)
        || get(/databases/$(database)/documents/agendaruang/$(id)/detak/host).data.waktu
             + duration.value(detik, 's') < request.time;
    }

    function ruangKedaluwarsa(id, r) {
      return (r.status == 'lobi' && r.jenis == 'publik'
               && request.time > r.dibuka + duration.value(10, 'm'))
        || (r.status == 'lobi' && r.jenis == 'publik' && detakBasi(id, 180))
        || (r.status in ['main', 'selesai'] && detakBasi(id, 180))
        || (r.status == 'selesai' && request.time > r.aktif + duration.value(5, 'm'));
    }

    /*
      Bentuk umum dokumen ruang. Diperiksa sekali di awal aturan update,
      sehingga fungsi lain di bawah tidak perlu mengulanginya. Firestore
      membatasi jumlah ekspresi yang dievaluasi per permintaan, dan pemeriksaan
      bentuk yang diulang di setiap cabang pernah melampaui batas itu.
    */
    function bentukRuang(d) {
      return d.keys().size() == 9
        && d.keys().hasAll(['jenis', 'status', 'sesi', 'host', 'hostNama',
                            'dibuka', 'aktif', 'jumlah', 'permainan'])
        && d.status in ['kosong', 'tertutup', 'lobi', 'main', 'selesai']
        && d.sesi is string && d.sesi.size() <= 40
        && d.host is string && d.host.size() <= 128
        && d.hostNama is string && d.hostNama.size() <= 20
        && d.jumlah is int && d.jumlah >= 0 && d.jumlah <= 200
        && (d.permainan == null || d.permainan is map);
    }

    // Ruang yang sedang tidak dipakai: publik "kosong", terkunci "tertutup".
    function bentukKosong(id, d) {
      return d.jenis == jenisRuangAgenda(id)
        && ((d.jenis == 'publik' && d.status == 'kosong')
            || (d.jenis == 'terkunci' && d.status == 'tertutup'))
        && d.sesi == '' && d.host == '' && d.hostNama == ''
        && d.dibuka == null && d.aktif == null
        && d.jumlah == 0 && d.permainan == null;
    }

    // Lobi baru dengan sesi baru. Sesi baru membuat semua pemain lama
    // otomatis bukan anggota lagi tanpa perlu menghapus dokumennya satu per satu.
    function bentukLobiBaru(lama, d, host) {
      return d.status == 'lobi'
        && d.host == host
        && d.sesi.size() >= 8 && d.sesi != lama.sesi
        && d.dibuka == request.time && d.aktif == request.time
        && d.jumlah == 0 && d.permainan == null;
    }

    function peralihanHostSah(lama, baru) {
      return (lama.status == 'lobi' && baru.status == 'lobi'
                && baru.dibuka == lama.dibuka && baru.permainan == null)
        || (lama.status == 'lobi' && baru.status == 'main'
                && baru.dibuka == lama.dibuka
                && !(lama.jenis == 'publik' && request.time > lama.dibuka + duration.value(10, 'm')))
        || (lama.status == 'main' && baru.status in ['main', 'selesai']
                && baru.dibuka == lama.dibuka)
        || (lama.status == 'selesai' && baru.status == 'selesai'
                && baru.dibuka == lama.dibuka)
        || (lama.status == 'selesai' && baru.status == 'lobi'
                && baru.dibuka == request.time && baru.permainan == null);
    }

    function ubahanHost(id, lama, baru) {
      return lama.host == request.auth.uid
        && lama.status in ['lobi', 'main', 'selesai']
        && baru.sesi == lama.sesi
        && baru.aktif == request.time
        && peralihanHostSah(lama, baru)
        && (baru.host == lama.host
            || (baru.host.size() > 0 && anggotaSesi(id, baru.host, lama.sesi)));
    }

    function bubarkanOlehHost(id, lama, baru) {
      return lama.host == request.auth.uid
        && baru.status in ['kosong', 'lobi']
        && ((lama.jenis == 'publik' && bentukKosong(id, baru))
            || (lama.jenis == 'terkunci' && bentukLobiBaru(lama, baru, '')));
    }

    function ambilAlihHost(id, lama, baru) {
      return baru.host == request.auth.uid
        && lama.host != request.auth.uid
        && lama.status in ['lobi', 'main', 'selesai']
        && baru.diff(lama).affectedKeys().hasOnly(['host', 'hostNama'])
        && baru.hostNama is string && baru.hostNama.size() >= 1 && baru.hostNama.size() <= 20
        && anggotaSesi(id, request.auth.uid, lama.sesi)
        && (lama.host == '' || detakBasi(id, 45));
    }

    function bukaPublik(id, lama, baru) {
      return lama.jenis == 'publik'
        && baru.status == 'lobi'
        && baru.host == request.auth.uid
        && baru.sesi != lama.sesi
        && (lama.status == 'kosong' || ruangKedaluwarsa(id, lama))
        && bentukLobiBaru(lama, baru, request.auth.uid)
        && baru.hostNama.size() >= 1;
    }

    function pulihkanTerkunci(id, lama, baru) {
      return lama.jenis == 'terkunci'
        && baru.status == 'lobi'
        && baru.host == ''
        && lama.status in ['main', 'selesai']
        && ruangKedaluwarsa(id, lama)
        && bentukLobiBaru(lama, baru, '');
    }

    function ubahanAsisten(id, lama, baru) {
      return lama.jenis == 'terkunci'
        && asistenAgenda()
        && (bentukKosong(id, baru) || bentukLobiBaru(lama, baru, ''));
    }

    match /agendaruang/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && ruangAgendaSah(id)
                    && bentukRuang(request.resource.data)
                    && bentukKosong(id, request.resource.data);
      allow update: if request.auth != null
                    && ruangAgendaSah(id)
                    && bentukRuang(request.resource.data)
                    && request.resource.data.jenis == resource.data.jenis
                    && (bukaPublik(id, resource.data, request.resource.data)
                        || pulihkanTerkunci(id, resource.data, request.resource.data)
                        || ubahanHost(id, resource.data, request.resource.data)
                        || bubarkanOlehHost(id, resource.data, request.resource.data)
                        || ambilAlihHost(id, resource.data, request.resource.data)
                        || ubahanAsisten(id, resource.data, request.resource.data));
      allow delete: if false;

      /*
        Satu dokumen per pemain, dengan Document ID sama dengan UID-nya.
        getAfter dipakai supaya membuka ruang dan bergabung bisa dikirim dalam
        satu batch: pemain pertama membuka ruang sekaligus menjadi anggotanya.
      */
      function pemainSah(uid, d) {
        let r = getAfter(/databases/$(database)/documents/agendaruang/$(id)).data;
        return request.auth != null
          && request.auth.uid == uid
          && d.keys().hasOnly(['nama', 'sesi', 'masuk', 'hadir', 'kode'])
          && d.nama is string && d.nama.size() >= 1 && d.nama.size() <= 20
          && r.sesi != '' && d.sesi == r.sesi
          && r.status in ['lobi', 'main'];
      }

      function kodeSah(d) {
        return dataRuang(id).jenis == 'publik'
          || (exists(/databases/$(database)/documents/agendakunci/$(id))
              && d.get('kode', '') == get(/databases/$(database)/documents/agendakunci/$(id)).data.kode);
      }

      match /pemain/{uid} {
        allow read: if request.auth != null
                    && (dataRuang(id).jenis == 'publik' || anggotaAgenda(id) || asistenAgenda());
        allow create: if pemainSah(uid, request.resource.data)
                      && request.resource.data.masuk == request.time
                      && request.resource.data.hadir == request.time
                      && kodeSah(request.resource.data);
        allow update: if pemainSah(uid, request.resource.data)
                      && ((request.resource.data.sesi != resource.data.sesi
                            && request.resource.data.masuk == request.time
                            && request.resource.data.hadir == request.time
                            && kodeSah(request.resource.data))
                          || (request.resource.data.sesi == resource.data.sesi
                            && request.resource.data.nama == resource.data.nama
                            && request.resource.data.masuk == resource.data.masuk
                            && (request.resource.data.hadir == request.time
                                || request.resource.data.hadir == resource.data.hadir)
                            && !('kode' in request.resource.data)));
        allow delete: if request.auth != null
                      && (request.auth.uid == uid
                          || dataRuang(id).host == request.auth.uid
                          || resource.data.sesi != dataRuang(id).sesi);
      }

      function saluranSah(r, d) {
        return d.saluran in [r.sesi + '_' + r.permainan.anggota.get(request.auth.uid, 'saksi'),
                             r.sesi + '_saksi'];
      }

      // Satu dokumen suara per pemain, ditimpa tiap ronde.
      match /suara/{uid} {
        allow read: if anggotaAgenda(id);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && anggotaAgenda(id)
          && dataRuang(id).status == 'main'
          && dataRuang(id).permainan.fase == 'voting'
          && request.resource.data.keys().hasOnly(['sesi', 'saluran', 'ronde', 'aksi', 'target'])
          && request.resource.data.sesi == dataRuang(id).sesi
          && request.resource.data.ronde == dataRuang(id).permainan.ronde
          && saluranSah(dataRuang(id), request.resource.data)
          && request.resource.data.aksi is string && request.resource.data.aksi.size() <= 20
          && request.resource.data.target is string && request.resource.data.target.size() <= 20;
        allow delete: if request.auth != null
          && (request.auth.uid == uid || resource.data.sesi != dataRuang(id).sesi);
      }

      // Obrolan internal kubu dan obrolan Saksi.
      match /obrolan/{pesanId} {
        allow read: if anggotaAgenda(id);
        allow create: if anggotaAgenda(id)
          && dataRuang(id).status in ['main', 'selesai']
          && request.resource.data.keys().hasOnly(['sesi', 'saluran', 'uid', 'nama', 'teks', 'waktu'])
          && request.resource.data.sesi == dataRuang(id).sesi
          && request.resource.data.uid == request.auth.uid
          && saluranSah(dataRuang(id), request.resource.data)
          && request.resource.data.nama is string && request.resource.data.nama.size() <= 20
          && request.resource.data.teks is string
          && request.resource.data.teks.size() >= 1 && request.resource.data.teks.size() <= 160
          && request.resource.data.waktu == request.time;
        allow update: if false;
        allow delete: if request.auth != null && resource.data.sesi != dataRuang(id).sesi;
      }

      // Detak host. Ditulis host tiap 15 detik, dibaca pemain untuk tahu
      // apakah host masih ada.
      match /detak/{nama} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && nama == 'host'
          && getAfter(/databases/$(database)/documents/agendaruang/$(id)).data.host == request.auth.uid
          && request.resource.data.keys().hasOnly(['waktu', 'uid'])
          && request.resource.data.waktu == request.time
          && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }
    }

    match /agendakunci/{id} {
      allow read: if asistenAgenda();
      allow create, update: if asistenAgenda()
        && id in ['kunci-1', 'kunci-2', 'kunci-3']
        && request.resource.data.keys().hasOnly(['kode', 'oleh', 'waktu'])
        && request.resource.data.kode is string
        && request.resource.data.kode.matches('^[A-Z0-9]{6}$')
        && request.resource.data.oleh == request.auth.token.email
        && request.resource.data.waktu == request.time;
      allow delete: if asistenAgenda();
    }

    // Koleksi yang tidak disebut di atas otomatis tertutup, karena Firestore
    // menolak apa pun yang tidak diizinkan secara eksplisit. Baris di bawah
    // hanya penegasan untuk pembaca; menghapusnya tidak mengubah apa pun.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
