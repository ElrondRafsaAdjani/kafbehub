/*
  ATURAN AKSES FIRESTORE (Firestore Security Rules)

  INI SATU-SATUNYA PENGAMAN DATA KAFBE HUB.

  Halaman /operasional hanyalah antarmuka. Siapa pun bisa membuka Console
  peramban dan memanggil Firestore langsung tanpa melewati halaman itu sama
  sekali. Yang menolak mereka adalah berkas ini, bukan halaman loginnya.

  CARA MEMASANG:
  1. Buka https://console.firebase.google.com -> pilih proyek "kafbe-hub"
  2. Build -> Firestore Database -> tab "Rules"
  3. Hapus seluruh isinya, tempel seluruh isi berkas ini, klik "Publish"

  Berkas ini disimpan di repo hanya sebagai salinan acuan supaya tidak hilang
  dan bisa ditinjau. Firestore TIDAK membacanya dari sini, jadi setiap kali
  berkas ini diubah, isinya harus ditempel ulang lewat langkah di atas.

  CARA MENAMBAH ADMIN BARU (misalnya adik tingkat yang meneruskan):
  1. Authentication -> Users -> Add user -> isi email dan password
  2. Salin nilai "User UID" yang muncul di daftar
  3. Firestore Database -> Data -> koleksi "admins" -> Add document
     - Document ID : tempel User UID tadi
     - Field       : nama (string), isi nama orangnya
  Tanpa langkah nomor 3, akun itu bisa login tapi tidak bisa mengubah apa pun.

  TIGA TINGKAT WEWENANG, DAN KENAPA DIPISAH:

    admins       -> halaman /operasional. Mengelola jadwal, perubahan
                    sementara, pengajar, dan pengumuman.
    pengajarakun -> halaman /pengajar. Mengubah naskah materi kuliah, dan
                    hanya pada mata kuliah yang disebut di dokumennya.
    adminutama   -> halaman /adminkafbe. Mengubah naskah situs, mematikan
                    fitur, dan menutup seluruh situs untuk pemeliharaan.

  Ketiganya koleksi terpisah dan tidak saling mewarisi. Terdaftar di "admins"
  tidak memberi akses ke /adminkafbe maupun /pengajar. Untuk memberi wewenang
  lain, ulangi langkah 1 sampai 3 di atas tapi pakai koleksi yang sesuai.

  Pemisahan ini disengaja: pengurus operasional berganti tiap kepengurusan dan
  jumlahnya banyak, pengajar hanya menyentuh naskah mata kuliahnya sendiri, dan
  yang boleh menutup situs sebaiknya sedikit.

  CARA MENAMBAH AKUN PENGAJAR:
  Tidak lewat Firebase Console. Pengajar mendaftar sendiri di halaman
  /pengajar dengan NRP, nama lengkap, dan email student UBAYA, lalu pengurus
  operasional menerima atau menolaknya di tab "Akun Pengajar". Aturan di bawah
  memastikan pendaftar tidak bisa menyetujui dirinya sendiri.

  Menambah lewat Console tetap boleh untuk keadaan darurat, misalnya saat
  belum ada satu pun pengurus yang bisa menyetujui. Dokumennya diisi:
    - nama   (string) : nama pengajarnya
    - nrp    (string) : NRP-nya
    - email  (string) : email akun Firebase-nya
    - status (string) : isi "diterima"
    - mk     (array)  : kode mata kuliah yang boleh diubah, misalnya
                        ["pemi", "stat2"]. Kodenya lihat shared/materi-daftar.js
    - semua  (boolean, opsional) : isi true kalau boleh mengubah semua mata
                        kuliah. Kalau diisi true, kolom mk tidak dipakai.

  CARA MENCABUT AKSES ADMIN:
  Hapus dokumennya dari koleksi "admins". Efeknya langsung. Menghapus akunnya
  di Authentication juga boleh, tapi menghapus dokumen admin sudah cukup.
*/

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benar hanya jika: sudah login DAN terdaftar di koleksi "admins".
    // Sekadar punya akun tidak cukup, sehingga akun yang bocor pun tidak
    // otomatis bisa mengubah data selama tidak didaftarkan di sini.
    function adminTerdaftar() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function tulisanAdmin() {
      return adminTerdaftar();
    }

    /*
      Tingkat kedua, di atas admin operasional.

      Pengurus operasional mengelola jadwal dan pengumuman. Yang mengubah
      tampilan situs, mematikan fitur, dan menutup seluruh situs adalah orang
      lain lagi, dan wewenang itu ditentukan koleksi "adminutama".

      Terdaftar di "admins" TIDAK memberi wewenang ini. Kedua koleksi berdiri
      sendiri, jadi pengurus operasional yang membuka /adminkafbe akan ditolak
      di sini, bukan cuma disembunyikan tombolnya di halaman.
    */
    function adminUtama() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminutama/$(request.auth.uid));
    }

    /*
      Tingkat tersendiri di samping keduanya: pengajar mata kuliah.

      Bedanya dengan dua tingkat di atas, wewenang pengajar TIDAK berlaku untuk
      seluruh koleksi, melainkan dibatasi per mata kuliah. Dokumen akunnya
      menyebut kode mata kuliah mana saja yang boleh disentuh, dan pembatasan
      itu ditegakkan di sini, bukan sekadar dengan menyaring daftar topik di
      halaman /pengajar. Daftar di halaman itu bisa dilewati lewat Console
      peramban; aturan ini tidak bisa.

      Kolom "semua" bernilai true dipakai untuk koordinator yang memang
      mengurus seluruh mata kuliah, supaya daftar mk-nya tidak perlu ditambah
      tiap kali ada mata kuliah baru.
    */
    function pengajarTerdaftar() {
      return request.auth != null
        && exists(/databases/$(database)/documents/pengajarakun/$(request.auth.uid));
    }

    function akunPengajar() {
      return get(/databases/$(database)/documents/pengajarakun/$(request.auth.uid)).data;
    }

    /*
      Punya dokumen saja tidak cukup, sebab dokumennya kini dibuat sendiri oleh
      yang mendaftar dan statusnya masih menunggu.

      Dokumen yang tidak menyebut status dianggap sudah diterima. Itu hanya
      berlaku untuk dokumen yang dibuat langsung lewat Firebase Console, karena
      pendaftaran dari web selalu dipaksa berstatus menunggu oleh aturan di
      bawah. Jadi bawaan ini tidak bisa dipakai melewati persetujuan.
    */
    function pengajarAktif() {
      return pengajarTerdaftar()
        && akunPengajar().get('status', 'diterima') == 'diterima';
    }

    function pengajarBoleh(kode) {
      return pengajarAktif()
        && (akunPengajar().get('semua', false) == true
            || kode in akunPengajar().get('mk', []));
    }

    // ---------- Daftar admin ----------
    // Sengaja tidak bisa ditulis dari web sama sekali, bahkan oleh admin.
    // Penambahan admin hanya lewat Firebase Console, supaya seorang admin yang
    // akunnya diambil alih tidak bisa mengangkat admin baru diam-diam.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Daftar admin utama ----------
    // Aturannya sama dengan "admins": hanya bisa ditambah lewat Firebase
    // Console, tidak pernah dari web, bahkan oleh admin utama sendiri.
    match /adminutama/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Daftar akun pengajar ----------
    /*
      BEDA SENDIRI DARI DUA DAFTAR DI ATAS: koleksi ini boleh ditulis dari web.

      Admin dan admin utama hanya bisa ditambah lewat Firebase Console, sebab
      jumlahnya sedikit dan wewenangnya luas. Pengajar jumlahnya banyak dan
      berganti tiap semester, jadi mengharuskan pengurus membuka Firebase
      Console untuk tiap orang hanya akan berakhir dengan satu akun yang
      dipakai beramai-ramai. Karena itu pendaftarannya dibuka, tapi
      persetujuannya tetap di tangan pengurus operasional.

      PEMBAGIAN YANG DIJAGA DI SINI

      Pendaftar hanya boleh MEMBUAT dokumen atas namanya sendiri, dengan
      status menunggu, dan tanpa satu pun kolom wewenang. Kolom "mk" dan
      "semua" tidak boleh ikut ditulis sama sekali pada tahap ini.

      Pengurus operasional yang MENGUBAH statusnya dan mengisi wewenangnya.
      Sebaliknya, pengurus tidak boleh menyunting nama, NRP, maupun email
      pendaftar, sehingga baris yang disetujui tetap baris yang diajukan.

      Kalau pemisahan ini dilonggarkan, seorang pendaftar bisa membuat
      dokumennya sendiri lengkap dengan status diterima dan daftar mata kuliah
      apa pun. Batas wewenang yang bisa ditulis sendiri oleh yang dibatasi
      tidak membatasi apa pun.
    */
    function pengajuanSah(isi) {
      return isi.keys().hasOnly(['status', 'nrp', 'nama', 'email', 'dibuatPada'])
        && isi.status == 'menunggu'
        && isi.nrp is string
        && isi.nrp.matches('^[0-9]{6,15}$')
        && isi.nama is string
        && isi.nama.size() >= 3
        && isi.nama.size() <= 80
        && isi.email == request.auth.token.email
        && isi.email.matches('^s[0-9]{6,15}@student[.]ubaya[.]ac[.]id$');
    }

    /*
      Keputusan pengurus. Yang boleh berubah hanya status, wewenang, dan
      catatan keputusannya. Identitas pendaftar dikunci pada nilai yang sudah
      tersimpan.
    */
    function keputusanSah(lama, baru) {
      return baru.keys().hasOnly([
               'status', 'nrp', 'nama', 'email', 'dibuatPada',
               'mk', 'semua', 'diputusPada', 'diputusOleh', 'alasan'
             ])
        && baru.nrp   == lama.nrp
        && baru.nama  == lama.nama
        && baru.email == lama.email
        && baru.status in ['menunggu', 'diterima', 'ditolak']
        && baru.diputusOleh == request.auth.token.email
        && baru.get('mk', []) is list
        && baru.get('mk', []).size() <= 30
        && baru.get('semua', false) is bool
        && baru.get('alasan', '') is string
        && baru.get('alasan', '').size() <= 200;
    }

    match /pengajarakun/{uid} {
      /*
        Pendaftar membaca dokumennya sendiri untuk tahu status pengajuannya,
        dan pengurus operasional membaca seluruhnya untuk menilai antrean.
        Selain keduanya, tertutup: isinya nama, NRP, dan email orang.
      */
      allow read: if request.auth != null
                  && (request.auth.uid == uid || adminTerdaftar());

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && pengajuanSah(request.resource.data);

      allow update: if adminTerdaftar()
                    && keputusanSah(resource.data, request.resource.data);

      /*
        Menghapus hanya oleh pengurus, dan gunanya bukan membersihkan jejak.
        Selama dokumennya masih ada, orang yang sama tidak bisa mendaftar lagi
        karena aturan create menolak dokumen yang sudah ada. Menghapus baris
        yang ditolak itulah cara memberi kesempatan mendaftar ulang.
      */
      allow delete: if adminTerdaftar();
    }

    // ---------- Dokumen ringkasan untuk halaman publik ----------
    // Dibaca semua pengunjung, ditulis ulang oleh halaman admin tiap menyimpan.
    //
    // Dokumen "situs" sengaja DIKECUALIKAN di sini dan diatur sendiri di bawah.
    // Firestore mengizinkan akses bila ADA SATU saja aturan yang mengizinkan,
    // bukan yang paling khusus, jadi tanpa pengecualian ini pengurus
    // operasional tetap bisa menulis publik/situs lewat aturan umum ini.
    match /publik/{doc} {
      allow read: if true;
      allow write: if tulisanAdmin() && doc != 'situs';
    }

    // ---------- Pengaturan tampilan situs ----------
    /*
      Ditulis hanya dari /adminkafbe, dibaca setiap halaman publik.

      Syarat "situs harus berstatus maintenance sebelum boleh diubah"
      ditegakkan DI SINI, bukan sekadar dengan menonaktifkan kotak isian di
      halaman admin. Halaman admin bisa dilewati lewat Console peramban;
      aturan ini tidak bisa.

      Ada dua jalan yang diizinkan:
        1. Dokumennya sudah berstatus maintenance, sehingga isinya bebas
           diubah selagi pengunjung melihat layar pemeliharaan.
        2. Yang berubah hanya saklar statusnya sendiri, sehingga situs tetap
           bisa dimasukkan ke dan dikeluarkan dari pemeliharaan.

      Akibatnya, mengubah naskah atau status fitur saat situs masih aktif
      selalu ditolak server, siapa pun yang mencoba dan lewat cara apa pun.
    */
    match /publik/situs {
      allow read: if true;
      allow create: if adminUtama();
      allow update: if adminUtama() && (
           resource.data.statusSitus == 'maintenance'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statusSitus', 'diperbaruiPada', 'diperbaruiOleh'])
      );
      allow delete: if false;
    }

    // ---------- Catatan kunjungan ----------
    /*
      Satu dokumen per hari, ditambah oleh pengunjung anonim lewat
      shared/kunjungan.js, dan hanya dibaca admin utama di dasbor.

      APA YANG BISA DAN TIDAK BISA DIJAMIN DI SINI

      Bentuk datanya dibatasi: nama dokumen harus berupa tanggal, dan hanya
      tujuh kolom di bawah yang boleh ditulis. Jadi koleksi ini tidak bisa
      dipakai orang lain sebagai tempat menitipkan data sembarangan.

      Yang TIDAK bisa dicegah tanpa server sendiri adalah orang menaikkan
      angkanya dengan memanggil Firestore berulang kali. Angka di dasbor
      karena itu perlu dibaca sebagai gambaran ramai sepinya kunjungan, bukan
      sebagai hitungan yang bisa dipertanggungjawabkan.

      Menghapus ditutup rapat, sehingga catatan yang sudah masuk tidak bisa
      dihilangkan lewat web oleh siapa pun.
    */
    match /statistik/{hari} {
      allow read: if adminUtama();
      allow create, update: if hari.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly([
             'tanggal', 'tampilan', 'perangkat', 'jam',
             'halaman', 'durasiTotal', 'durasiJumlah'
           ]);
      allow delete: if false;
    }

    // ---------- Catatan versi ----------
    // Catatan perubahan yang ditulis admin utama. Tidak dibuka untuk publik
    // karena isinya catatan kerja internal, termasuk siapa yang menulisnya.
    //
    // Sengaja TIDAK ikut disyaratkan status maintenance: catatan ini merekam
    // pekerjaan yang sudah selesai, dan biasanya baru ditulis setelah situs
    // dinyalakan kembali. Menguncinya akan membuat catatan justru tidak ditulis.
    match /catatanversi/{id} {
      allow read: if adminUtama();
      allow write: if adminUtama();
    }

    // ---------- Data kerja admin ----------
    // Boleh dibaca publik supaya halaman jadwal tetap bisa jalan seandainya
    // dokumen ringkasan bermasalah, tapi hanya admin yang boleh mengubah.
    match /matakuliah/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /jadwal/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /perubahan/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /pengumuman/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Naskah materi kuliah ----------
    /*
      Satu dokumen per topik, dengan Document ID sama dengan nama berkas
      halamannya, misalnya "pemi-elastisitas". Isinya naskah pengganti yang
      ditulis pengajar lewat halaman /pengajar, dan dibaca setiap mahasiswa
      yang membuka halaman materinya.

      TIGA HAL YANG DIJAGA DI SINI

      1. Hanya pengajar yang berwenang atas mata kuliahnya yang boleh menulis.
      2. Nama dokumennya harus diawali kode mata kuliah yang sama dengan isi
         kolom "kode". Tanpa syarat ini, pengajar Pengantar Mikroekonomi bisa
         menulis dokumen "stat2-nilai-z" sambil mengisi kodenya "pemi", dan
         pemeriksaan wewenang di atas akan meloloskannya.
      3. Bentuk datanya dibatasi, sehingga koleksi ini tidak bisa dipakai
         sebagai tempat menitipkan data lain.

      Menghapus ditutup untuk semua orang. Mengembalikan naskah ke bawaan
      halaman dilakukan dengan mengosongkan isinya lewat halaman /pengajar,
      bukan dengan menghapus dokumennya, sehingga catatan siapa yang terakhir
      mengubah tidak ikut hilang.

      Yang TIDAK dijaga di sini adalah isi markup-nya. Naskah tetap disaring
      shared/materi.js di sisi pembaca sebelum dipasang ke halaman.
    */
    function materiSah(id, isi) {
      return isi.keys().hasOnly([
               'kode', 'naskah', 'langkah', 'peta',
               'diperbaruiPada', 'diperbaruiOleh'
             ])
        && isi.kode is string
        && id.split('-')[0] == isi.kode
        && isi.naskah is map
        && isi.langkah is map
        && isi.peta is map
        && isi.diperbaruiOleh == request.auth.token.email;
    }

    match /materi/{id} {
      allow read: if true;
      allow create: if materiSah(id, request.resource.data)
                    && pengajarBoleh(request.resource.data.kode);
      allow update: if materiSah(id, request.resource.data)
                    && pengajarBoleh(request.resource.data.kode)
                    && pengajarBoleh(resource.data.kode);
      allow delete: if false;
    }

    // ---------- Data pengajar ----------
    // Nama dan NRP asisten memang sudah diumumkan lewat kanal resmi KAFBE,
    // jadi tidak ada yang perlu dirahasiakan dan aturannya disamakan dengan
    // koleksi lain.
    //
    // Meski begitu, datanya tetap TIDAK ditampilkan di halaman mana pun yang
    // dibuka mahasiswa, dan tidak ikut ditulis ke dokumen publik/terkini.
    // Hanya halaman operasional yang memakainya.
    match /pengajar/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Kode kelas Google Classroom ----------
    /*
      BEDA SENDIRI DARI KOLEKSI LAIN: koleksi ini TIDAK boleh dibaca publik.

      Kode kelas adalah kunci masuk. Siapa pun yang memegangnya bisa bergabung
      ke kelas daring mata kuliah mana pun tanpa pernah menjadi mahasiswanya,
      lalu ikut melihat materi dan tugas di dalamnya. Karena itu aturannya
      dibuat tertutup, tidak disamakan dengan jadwal yang memang diumumkan.
    */
    match /classroom/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Koordinator mata kuliah ----------
    /*
      Ikut ditutup dari publik dengan alasan berbeda: isinya nomor WA dan akun
      Line pengurus. Nama dan NRP memang sudah diumumkan, tapi kontak pribadi
      tidak, dan sekali koleksi ini dibuka, seluruh daftar kontak pengurus bisa
      diunduh sekaligus oleh siapa saja.
    */
    match /koordinator/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Catatan aksi pengurus ----------
    /*
      HANYA BISA DITAMBAH. Mengubah dan menghapus ditutup untuk semua orang,
      termasuk pengurus yang menulisnya sendiri.

      Ini inti gunanya. Catatan yang bisa dirapikan sendiri oleh pelakunya
      tidak bisa dipakai menelusuri apa pun, karena bagian yang paling ingin
      ditelusuri justru yang paling mungkin dihapus. Membersihkan catatan lama
      hanya bisa lewat Firebase Console, dan itu memang disengaja.

      Pengajar ikut boleh menambah catatan, karena perubahan naskah materi juga
      perlu bisa ditelusuri. Membacanya tetap hanya pengurus operasional,
      sebab catatan ini memuat pekerjaan semua orang, bukan hanya pekerjaan
      yang menulisnya.

      Tidak dibuka untuk publik karena isinya menyebut nama dan email pengurus,
      beserta jam kerja mereka.

      Bentuk datanya dibatasi supaya koleksi ini tidak bisa dipakai sebagai
      tempat menitipkan data lain, dan supaya baris palsu tidak bisa ditulis
      atas nama orang lain: kolom email harus sama dengan email akun yang
      sedang login.
    */
    match /log/{id} {
      allow read: if adminTerdaftar();
      allow create: if (tulisanAdmin() || pengajarAktif())
        && request.resource.data.keys().hasOnly([
             'waktu', 'waktuKlien', 'oleh', 'email', 'aksi', 'jenis', 'ringkas', 'rincian'
           ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.aksi is string
        && request.resource.data.jenis is string
        && request.resource.data.ringkas.size() <= 500
        && request.resource.data.rincian.size() <= 500;
      allow update, delete: if false;
    }

    // ---------- Papan skor game ----------
    // Dibiarkan seperti sebelumnya: siapa pun boleh menambah skor tanpa login,
    // tapi bentuk datanya dibatasi, dan skor yang sudah masuk tidak bisa
    // diubah atau dihapus oleh siapa pun lewat web.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.game is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 14
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100000;
      allow update, delete: if false;
    }

    // Koleksi yang tidak disebut di atas otomatis tertutup, karena Firestore
    // menolak apa pun yang tidak diizinkan secara eksplisit. Baris di bawah
    // hanya penegasan untuk pembaca; menghapusnya tidak mengubah apa pun.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
