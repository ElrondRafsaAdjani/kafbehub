/*
  ATURAN AKSES FIRESTORE (Firestore Security Rules)

  INI SATU-SATUNYA PENGAMAN DATA KAFBE HUB.

  Halaman /operasional hanyalah antarmuka. Siapa pun bisa membuka Console
  peramban dan memanggil Firestore langsung tanpa melewati halaman itu sama
  sekali. Yang menolak mereka adalah berkas ini, bukan halaman loginnya.

  CARA MEMASANG:
  1. Buka https://console.firebase.google.com -> pilih proyek "kafbe-hub"
  2. Build -> Firestore Database -> tab "Rules"
  3. Hapus seluruh isinya, tempel seluruh isi berkas ini, klik "Publish"

  Berkas ini disimpan di repo hanya sebagai salinan acuan supaya tidak hilang
  dan bisa ditinjau. Firestore TIDAK membacanya dari sini, jadi setiap kali
  berkas ini diubah, isinya harus ditempel ulang lewat langkah di atas.

  CARA MENAMBAH ADMIN BARU (misalnya adik tingkat yang meneruskan):
  1. Authentication -> Users -> Add user -> isi email dan password
  2. Salin nilai "User UID" yang muncul di daftar
  3. Firestore Database -> Data -> koleksi "admins" -> Add document
     - Document ID : tempel User UID tadi
     - Field       : nama (string), isi nama orangnya
  Tanpa langkah nomor 3, akun itu bisa login tapi tidak bisa mengubah apa pun.

  DUA TINGKAT WEWENANG, DAN KENAPA DIPISAH:

    admins      -> halaman /operasional. Mengelola jadwal, perubahan
                   sementara, pengajar, dan pengumuman.
    adminutama  -> halaman /adminkafbe. Mengubah naskah situs, mematikan
                   fitur, dan menutup seluruh situs untuk pemeliharaan.

  Keduanya koleksi terpisah dan tidak saling mewarisi. Terdaftar di "admins"
  tidak memberi akses ke /adminkafbe. Untuk memberi wewenang admin utama,
  ulangi langkah 1 sampai 3 di atas tapi pakai koleksi "adminutama".

  Pemisahan ini disengaja: pengurus operasional berganti tiap kepengurusan dan
  jumlahnya banyak, sedangkan yang boleh menutup situs sebaiknya sedikit.

  CARA MENCABUT AKSES ADMIN:
  Hapus dokumennya dari koleksi "admins". Efeknya langsung. Menghapus akunnya
  di Authentication juga boleh, tapi menghapus dokumen admin sudah cukup.
*/

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benar hanya jika: sudah login DAN terdaftar di koleksi "admins".
    // Sekadar punya akun tidak cukup, sehingga akun yang bocor pun tidak
    // otomatis bisa mengubah data selama tidak didaftarkan di sini.
    function adminTerdaftar() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function tulisanAdmin() {
      return adminTerdaftar();
    }

    /*
      Tingkat kedua, di atas admin operasional.

      Pengurus operasional mengelola jadwal dan pengumuman. Yang mengubah
      tampilan situs, mematikan fitur, dan menutup seluruh situs adalah orang
      lain lagi, dan wewenang itu ditentukan koleksi "adminutama".

      Terdaftar di "admins" TIDAK memberi wewenang ini. Kedua koleksi berdiri
      sendiri, jadi pengurus operasional yang membuka /adminkafbe akan ditolak
      di sini, bukan cuma disembunyikan tombolnya di halaman.
    */
    function adminUtama() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminutama/$(request.auth.uid));
    }

    // ---------- Daftar admin ----------
    // Sengaja tidak bisa ditulis dari web sama sekali, bahkan oleh admin.
    // Penambahan admin hanya lewat Firebase Console, supaya seorang admin yang
    // akunnya diambil alih tidak bisa mengangkat admin baru diam-diam.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Daftar admin utama ----------
    // Aturannya sama dengan "admins": hanya bisa ditambah lewat Firebase
    // Console, tidak pernah dari web, bahkan oleh admin utama sendiri.
    match /adminutama/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Dokumen ringkasan untuk halaman publik ----------
    // Dibaca semua pengunjung, ditulis ulang oleh halaman admin tiap menyimpan.
    //
    // Dokumen "situs" sengaja DIKECUALIKAN di sini dan diatur sendiri di bawah.
    // Firestore mengizinkan akses bila ADA SATU saja aturan yang mengizinkan,
    // bukan yang paling khusus, jadi tanpa pengecualian ini pengurus
    // operasional tetap bisa menulis publik/situs lewat aturan umum ini.
    match /publik/{doc} {
      allow read: if true;
      allow write: if tulisanAdmin() && doc != 'situs';
    }

    // ---------- Pengaturan tampilan situs ----------
    /*
      Ditulis hanya dari /adminkafbe, dibaca setiap halaman publik.

      Syarat "situs harus berstatus maintenance sebelum boleh diubah"
      ditegakkan DI SINI, bukan sekadar dengan menonaktifkan kotak isian di
      halaman admin. Halaman admin bisa dilewati lewat Console peramban;
      aturan ini tidak bisa.

      Ada dua jalan yang diizinkan:
        1. Dokumennya sudah berstatus maintenance, sehingga isinya bebas
           diubah selagi pengunjung melihat layar pemeliharaan.
        2. Yang berubah hanya saklar statusnya sendiri, sehingga situs tetap
           bisa dimasukkan ke dan dikeluarkan dari pemeliharaan.

      Akibatnya, mengubah naskah atau status fitur saat situs masih aktif
      selalu ditolak server, siapa pun yang mencoba dan lewat cara apa pun.
    */
    match /publik/situs {
      allow read: if true;
      allow create: if adminUtama();
      allow update: if adminUtama() && (
           resource.data.statusSitus == 'maintenance'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statusSitus', 'diperbaruiPada', 'diperbaruiOleh'])
      );
      allow delete: if false;
    }

    // ---------- Catatan kunjungan ----------
    /*
      Satu dokumen per hari, ditambah oleh pengunjung anonim lewat
      shared/kunjungan.js, dan hanya dibaca admin utama di dasbor.

      APA YANG BISA DAN TIDAK BISA DIJAMIN DI SINI

      Bentuk datanya dibatasi: nama dokumen harus berupa tanggal, dan hanya
      tujuh kolom di bawah yang boleh ditulis. Jadi koleksi ini tidak bisa
      dipakai orang lain sebagai tempat menitipkan data sembarangan.

      Yang TIDAK bisa dicegah tanpa server sendiri adalah orang menaikkan
      angkanya dengan memanggil Firestore berulang kali. Angka di dasbor
      karena itu perlu dibaca sebagai gambaran ramai sepinya kunjungan, bukan
      sebagai hitungan yang bisa dipertanggungjawabkan.

      Menghapus ditutup rapat, sehingga catatan yang sudah masuk tidak bisa
      dihilangkan lewat web oleh siapa pun.
    */
    match /statistik/{hari} {
      allow read: if adminUtama();
      allow create, update: if hari.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly([
             'tanggal', 'tampilan', 'perangkat', 'jam',
             'halaman', 'durasiTotal', 'durasiJumlah'
           ]);
      allow delete: if false;
    }

    // ---------- Catatan versi ----------
    // Catatan perubahan yang ditulis admin utama. Tidak dibuka untuk publik
    // karena isinya catatan kerja internal, termasuk siapa yang menulisnya.
    //
    // Sengaja TIDAK ikut disyaratkan status maintenance: catatan ini merekam
    // pekerjaan yang sudah selesai, dan biasanya baru ditulis setelah situs
    // dinyalakan kembali. Menguncinya akan membuat catatan justru tidak ditulis.
    match /catatanversi/{id} {
      allow read: if adminUtama();
      allow write: if adminUtama();
    }

    // ---------- Data kerja admin ----------
    // Boleh dibaca publik supaya halaman jadwal tetap bisa jalan seandainya
    // dokumen ringkasan bermasalah, tapi hanya admin yang boleh mengubah.
    match /matakuliah/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /jadwal/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /perubahan/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /pengumuman/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    match /pengaturan/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Data pengajar ----------
    // Nama dan NRP asisten memang sudah diumumkan lewat kanal resmi KAFBE,
    // jadi tidak ada yang perlu dirahasiakan dan aturannya disamakan dengan
    // koleksi lain.
    //
    // Meski begitu, datanya tetap TIDAK ditampilkan di halaman mana pun yang
    // dibuka mahasiswa, dan tidak ikut ditulis ke dokumen publik/terkini.
    // Hanya halaman operasional yang memakainya.
    match /pengajar/{id} {
      allow read: if true;
      allow write: if tulisanAdmin();
    }

    // ---------- Kode kelas Google Classroom ----------
    /*
      BEDA SENDIRI DARI KOLEKSI LAIN: koleksi ini TIDAK boleh dibaca publik.

      Kode kelas adalah kunci masuk. Siapa pun yang memegangnya bisa bergabung
      ke kelas daring mata kuliah mana pun tanpa pernah menjadi mahasiswanya,
      lalu ikut melihat materi dan tugas di dalamnya. Karena itu aturannya
      dibuat tertutup, tidak disamakan dengan jadwal yang memang diumumkan.
    */
    match /classroom/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Koordinator mata kuliah ----------
    /*
      Ikut ditutup dari publik dengan alasan berbeda: isinya nomor WA dan akun
      Line pengurus. Nama dan NRP memang sudah diumumkan, tapi kontak pribadi
      tidak, dan sekali koleksi ini dibuka, seluruh daftar kontak pengurus bisa
      diunduh sekaligus oleh siapa saja.
    */
    match /koordinator/{id} {
      allow read: if adminTerdaftar();
      allow write: if tulisanAdmin();
    }

    // ---------- Papan skor game ----------
    // Dibiarkan seperti sebelumnya: siapa pun boleh menambah skor tanpa login,
    // tapi bentuk datanya dibatasi, dan skor yang sudah masuk tidak bisa
    // diubah atau dihapus oleh siapa pun lewat web.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.game is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 14
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100000;
      allow update, delete: if false;
    }

    // Koleksi yang tidak disebut di atas otomatis tertutup, karena Firestore
    // menolak apa pun yang tidak diizinkan secara eksplisit. Baris di bawah
    // hanya penegasan untuk pembaca; menghapusnya tidak mengubah apa pun.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
